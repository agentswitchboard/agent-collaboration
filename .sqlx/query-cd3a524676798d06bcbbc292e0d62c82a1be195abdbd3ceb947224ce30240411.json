  "query": "SELECT s.actor_id,s.machine_id,s.enrollment_id,s.harness_session_id,s.create_operation_id,s.create_contents_digest,s.create_attempt,s.agent_program,s.session_kind,s.creator_kind,s.creator_actor_id,s.secret_hash,s.session_state,s.reserved_until,s.bound_at,s.settled_cause,s.settled_at,CASE WHEN s.session_kind = 'delegate' THEN s.creator_actor_id END AS parent_actor_id FROM actor_delegates d JOIN actor_sessions s ON s.actor_id=d.parent_actor_id WHERE d.actor_id=? AND d.parent_actor_id=? AND s.machine_id=? AND s.enrollment_id=?\n",
