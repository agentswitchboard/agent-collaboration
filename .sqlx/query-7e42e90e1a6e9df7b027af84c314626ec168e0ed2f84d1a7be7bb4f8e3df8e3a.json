  "db_name": "SQLite",
  "query": "SELECT message_id, created_at, updated_at, message_json, delivery_state_json FROM inbox_messages\n             WHERE CASE WHEN json_valid(delivery_state_json)\n                        THEN json_extract(delivery_state_json, '$.receipt.kind') IS NOT 'confirmed'\n                        ELSE 1 END\n             ORDER BY created_at, message_id",
