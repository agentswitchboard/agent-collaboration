{
  "$defs": {
    "OrganizationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RecordPageLimit": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkspaceId"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The last workspace ID of the previous page; absent or null for the first."
    },
    "limit": {
      "$ref": "#/$defs/RecordPageLimit",
      "default": 100
    },
    "organizationId": {
      "$ref": "#/$defs/OrganizationId"
    }
  },
  "required": [
    "organizationId"
  ],
  "title": "ListWorkspacesRequest",
  "type": "object"
}
