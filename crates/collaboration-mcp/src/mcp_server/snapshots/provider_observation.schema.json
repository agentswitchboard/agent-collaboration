{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"#/$defs/ProviderObservationRecord","title":"Codex Router event-hub observation","description":"Record root, with ProviderObservationNotification and SessionEvent available as definitions.","x-router-version":"0.1.164",
"$defs":{
"SessionEvent":{"oneOf":[{"type":"object","additionalProperties":false,"properties":{"turnId":{"type":"string"},"inputId":{"$ref":"#/$defs/InputId"},"kind":{"type":"string","const":"turnStarted"}},"required":["kind","turnId","inputId"]},{"type":"object","additionalProperties":false,"properties":{"inputId":{"$ref":"#/$defs/InputId"},"turnId":{"type":"string"},"kind":{"type":"string","const":"inputAccepted"}},"required":["kind","inputId","turnId"]},{"type":"object","additionalProperties":false,"properties":{"turnId":{"type":"string"},"outcome":{"$ref":"#/$defs/TurnOutcome"},"kind":{"type":"string","const":"turnEnded"}},"required":["kind","turnId","outcome"]},{"type":"object","additionalProperties":false,"properties":{"item":{"$ref":"#/$defs/SessionItem"},"kind":{"type":"string","const":"itemStarted"}},"required":["kind","item"]},{"type":"object","additionalProperties":false,"properties":{"item":{"$ref":"#/$defs/SessionItem"},"kind":{"type":"string","const":"itemUpdated"}},"required":["kind","item"]},{"type":"object","additionalProperties":false,"properties":{"itemId":{"type":"string"},"kind":{"type":"string","const":"itemCompleted"}},"required":["kind","itemId"]},{"type":"object","additionalProperties":false,"properties":{"interaction":{"$ref":"#/$defs/PendingInteraction"},"kind":{"type":"string","const":"interactionRequested"}},"required":["kind","interaction"]},{"type":"object","additionalProperties":false,"properties":{"requestId":{"type":"string"},"kind":{"type":"string","const":"interactionResolved"}},"required":["kind","requestId"]},{"type":"object","additionalProperties":false,"properties":{"state":{"$ref":"#/$defs/SessionState"},"kind":{"type":"string","const":"stateChanged"}},"required":["kind","state"]},{"type":"object","additionalProperties":false,"properties":{"capabilities":{"$ref":"#/$defs/CapabilityReport"},"kind":{"type":"string","const":"capabilitiesChanged"}},"required":["kind","capabilities"]},{"type":"object","additionalProperties":false,"properties":{"settings":{"$ref":"#/$defs/SessionSettings"},"kind":{"type":"string","const":"settingsChanged"}},"required":["kind","settings"]},{"type":"object","additionalProperties":false,"properties":{"replayEpoch":{"type":"integer","format":"uint64","minimum":0,"maximum":18446744073709551615},"kind":{"type":"string","const":"resyncRequired"}},"required":["kind","replayEpoch"],"description":"Control event on an obsolete subscription when history replay resets."}],"description":"Events carry domain facts; the hub assigns sequence numbers and owns replay."},
"InputId":{"type":"string"},
"TurnOutcome":{"oneOf":[{"type":"object","additionalProperties":false,"properties":{"stop_reason":{"$ref":"#/$defs/StopReason"},"local_cause":{"anyOf":[{"$ref":"#/$defs/LocalCause"},{"type":"null"}]},"kind":{"type":"string","const":"ended"}},"required":["kind","stop_reason","local_cause"]},{"type":"object","additionalProperties":false,"properties":{"reason":{"$ref":"#/$defs/TurnLostReason"},"kind":{"type":"string","const":"lost"}},"required":["kind","reason"]}],"description":"Ended carries an agent-confirmed stop reason; lost carries no such claim."},
"StopReason":{"oneOf":[{"type":"string","enum":["endTurn","maxTokens","maxTurnRequests","refusal","cancelled"]},{"type":"object","properties":{"unknown":{"type":"string"}},"required":["unknown"],"additionalProperties":false}]},
"LocalCause":{"oneOf":[{"type":"string","enum":["outputOverflow"]},{"type":"object","properties":{"other":{"type":"string"}},"required":["other"],"additionalProperties":false}]},
"TurnLostReason":{"type":"string","enum":["providerRetired","providerTurnFailed","endNotObservable"]},
"SessionItem":{"type":"object","additionalProperties":false,"properties":{"itemId":{"type":"string"},"kind":{"$ref":"#/$defs/SessionItemKind"},"text":{"type":["string","null"]}},"required":["itemId","kind","text"],"description":"Text is retained for history and simple facades; structured payloads can\nbe added at this boundary when a consumer needs their exact shape."},
"SessionItemKind":{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"userMessage"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"agentMessage"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"agentThought"}},"required":["kind"],"additionalProperties":false},{"type":"object","additionalProperties":false,"properties":{"tool_kind":{"type":"string"},"status":{"$ref":"#/$defs/ToolCallStatus"},"kind":{"type":"string","const":"toolCall"}},"required":["kind","tool_kind","status"]},{"type":"object","properties":{"kind":{"type":"string","const":"plan"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"usage"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"modeChange"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"configChange"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"sessionInfo"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"notice"}},"required":["kind"],"additionalProperties":false},{"type":"object","additionalProperties":false,"properties":{"source_kind":{"type":"string"},"kind":{"type":"string","const":"unknown"}},"required":["kind","source_kind"]}]},
"ToolCallStatus":{"type":"string","enum":["pending","inProgress","completed","failed"]},
"PendingInteraction":{"oneOf":[{"type":"object","additionalProperties":false,"properties":{"approver":{"$ref":"#/$defs/Identity"},"request":{"$ref":"#/$defs/ApprovalRequest"},"kind":{"type":"string","const":"approval"}},"required":["kind","approver","request"]},{"type":"object","additionalProperties":false,"properties":{"approver":{"$ref":"#/$defs/Identity"},"request":{"$ref":"#/$defs/QuestionRequest"},"kind":{"type":"string","const":"question"}},"required":["kind","approver","request"]}]},
"Identity":{"oneOf":[{"type":"object","additionalProperties":false,"properties":{"session":{"$ref":"#/$defs/SessionRef"},"kind":{"type":"string","const":"session"}},"required":["kind","session"]},{"type":"object","additionalProperties":false,"properties":{"humanId":{"$ref":"#/$defs/HumanId"},"kind":{"type":"string","const":"human"}},"required":["kind","humanId"]}]},
"SessionRef":{"type":"object","additionalProperties":false,"properties":{"endpoint":{"$ref":"#/$defs/SessionEndpointRef"},"sessionId":{"$ref":"#/$defs/SessionId"}},"required":["endpoint","sessionId"]},
"SessionEndpointRef":{"type":"object","additionalProperties":false,"properties":{"serviceId":{"$ref":"#/$defs/ServiceId"},"endpointId":{"$ref":"#/$defs/EndpointId"}},"required":["serviceId","endpointId"]},
"ServiceId":{"type":"string","minLength":36,"maxLength":36,"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])","x-maxUtf8Bytes":36},
"EndpointId":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])","x-maxUtf8Bytes":64},
"SessionId":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^[^\\u0000]+$","x-maxUtf8Bytes":4096},
"HumanId":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^[^\\u0000]+$","x-maxUtf8Bytes":4096},
"ApprovalRequest":{"type":"object","additionalProperties":false,"properties":{"requestId":{"type":"string"},"title":{"type":"string"},"description":{"type":["string","null"]},"subject":{"anyOf":[{"$ref":"#/$defs/ApprovalSubject"},{"type":"null"}]},"optionsOrigin":{"$ref":"#/$defs/OptionsOrigin","default":"agentOffered"},"options":{"$ref":"#/$defs/OfferedOptions"}},"required":["requestId","title","optionsOrigin","options"]},
"ApprovalSubject":{"oneOf":[{"type":"object","additionalProperties":false,"properties":{"toolCall":{"$ref":"#/$defs/ApprovalToolCallSubject"},"type":{"type":"string","const":"tool_call"}},"required":["type","toolCall"]},{"type":"object","additionalProperties":false,"properties":{"command":{"type":"string"},"cwd":{"type":"string"},"type":{"type":"string","const":"command"}},"required":["type","command","cwd"]},{"type":"object","additionalProperties":false,"properties":{"toolCallId":{"type":"string"},"planItemId":{"type":"string"},"type":{"type":"string","const":"plan"}},"required":["type","toolCallId","planItemId"]}]},
"ApprovalToolCallSubject":{"type":"object","additionalProperties":false,"properties":{"toolCallId":{"type":"string"},"kind":{"type":"string"},"title":{"type":"string"}},"required":["toolCallId","kind","title"]},
"OptionsOrigin":{"type":"string","enum":["agentOffered","routerSynthesized"]},
"OfferedOptions":{"type":"array","items":{"$ref":"#/$defs/OfferedOption"},"minItems":1},
"OfferedOption":{"type":"object","additionalProperties":false,"properties":{"optionId":{"$ref":"#/$defs/OfferedOptionId"},"label":{"type":"string"},"choice":{"$ref":"#/$defs/ApprovalChoice"}},"required":["optionId","label","choice"]},
"OfferedOptionId":{"type":"string","description":"ACP option IDs are opaque. Validation never trims or rewrites them."},
"ApprovalChoice":{"type":"object","additionalProperties":false,"properties":{"effect":{"$ref":"#/$defs/ApprovalEffect"},"scope":{"$ref":"#/$defs/ApprovalScope"}},"required":["effect","scope"]},
"ApprovalEffect":{"type":"string","enum":["allow","decline","abort"],"description":"Effect of choosing an option offered by the agent. The option ID remains\nthe agent's own identifier and is carried separately."},
"ApprovalScope":{"oneOf":[{"type":"string","enum":["once","session"]},{"type":"object","properties":{"persistent":{"type":"object","properties":{"where_stored":{"$ref":"#/$defs/StorageDestination"}},"required":["where_stored"]}},"required":["persistent"],"additionalProperties":false}]},
"StorageDestination":{"type":"string"},
"QuestionRequest":{"type":"object","additionalProperties":false,"properties":{"requestId":{"type":"string"},"prompt":{"type":"string"},"fields":{"$ref":"#/$defs/QuestionFields"}},"required":["requestId","prompt","fields"]},
"QuestionFields":{"type":"array","items":{"$ref":"#/$defs/QuestionField"},"minItems":1},
"QuestionField":{"oneOf":[{"type":"object","additionalProperties":false,"properties":{"fieldId":{"type":"string"},"label":{"type":"string"},"description":{"type":["string","null"]},"required":{"type":"boolean"},"kind":{"type":"string","const":"text"}},"required":["kind","fieldId","label","description","required"]},{"type":"object","additionalProperties":false,"properties":{"fieldId":{"type":"string"},"label":{"type":"string"},"description":{"type":["string","null"]},"required":{"type":"boolean"},"kind":{"type":"string","const":"number"}},"required":["kind","fieldId","label","description","required"]},{"type":"object","additionalProperties":false,"properties":{"fieldId":{"type":"string"},"label":{"type":"string"},"description":{"type":["string","null"]},"required":{"type":"boolean"},"kind":{"type":"string","const":"boolean"}},"required":["kind","fieldId","label","description","required"]},{"type":"object","additionalProperties":false,"properties":{"fieldId":{"type":"string"},"label":{"type":"string"},"description":{"type":["string","null"]},"required":{"type":"boolean"},"options":{"type":"array","items":{"$ref":"#/$defs/ChoiceOption"}},"kind":{"type":"string","const":"singleChoice"}},"required":["kind","fieldId","label","description","required","options"]},{"type":"object","additionalProperties":false,"properties":{"fieldId":{"type":"string"},"label":{"type":"string"},"description":{"type":["string","null"]},"required":{"type":"boolean"},"options":{"type":"array","items":{"$ref":"#/$defs/ChoiceOption"}},"min":{"type":["integer","null"],"format":"uint","minimum":0},"max":{"type":["integer","null"],"format":"uint","minimum":0},"kind":{"type":"string","const":"multiChoice"}},"required":["kind","fieldId","label","description","required","options","min","max"]}]},
"ChoiceOption":{"type":"object","additionalProperties":false,"properties":{"optionId":{"type":"string"},"label":{"type":"string"}},"required":["optionId","label"]},
"SessionState":{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"unloaded"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"idle"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"running"}},"required":["kind"],"additionalProperties":false},{"type":"object","additionalProperties":false,"properties":{"pending":{"$ref":"#/$defs/PendingInteractions"},"kind":{"type":"string","const":"requiresAction"}},"required":["kind","pending"]},{"type":"object","properties":{"kind":{"type":"string","const":"authenticationRequired"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"closed"}},"required":["kind"],"additionalProperties":false}]},
"PendingInteractions":{"type":"array","items":{"$ref":"#/$defs/PendingInteraction"},"minItems":1},
"CapabilityReport":{"type":"object","additionalProperties":false,"properties":{"load":{"type":"boolean"},"resume":{"type":"boolean"},"close":{"type":"boolean"},"list":{"type":"boolean"},"steer":{"type":"boolean"},"queue":{"anyOf":[{"$ref":"#/$defs/QueueSupport"},{"type":"null"}]},"modes":{"type":"boolean"},"configOptions":{"type":"boolean"},"elicitation":{"type":"boolean"},"usage":{"type":"boolean"},"promptContent":{"$ref":"#/$defs/PromptContentCapabilities"},"authStatus":{"$ref":"#/$defs/ProviderAuthStatus"}},"required":["load","resume","close","list","steer","queue","modes","configOptions","elicitation","usage","promptContent","authStatus"],"description":"Features confirmed by the agent and its back door for one Session."},
"QueueSupport":{"type":"object","additionalProperties":false,"properties":{"kind":{"$ref":"#/$defs/QueueCapability"},"canCancel":{"type":"boolean"}},"required":["kind","canCancel"]},
"QueueCapability":{"type":"string","enum":["native","router"]},
"PromptContentCapabilities":{"type":"object","additionalProperties":false,"properties":{"image":{"type":"boolean"},"audio":{"type":"boolean"},"embeddedContext":{"type":"boolean"}},"required":["image","audio","embeddedContext"]},
"ProviderAuthStatus":{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"notReported"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"loggedOut"}},"required":["kind"],"additionalProperties":false},{"type":"object","additionalProperties":false,"properties":{"label":{"type":"string"},"kind":{"type":"string","const":"account"}},"required":["kind","label"]},{"type":"object","additionalProperties":false,"properties":{"label":{"type":"string"},"kind":{"type":"string","const":"apiKey"}},"required":["kind","label"]},{"type":"object","additionalProperties":false,"properties":{"label":{"type":"string"},"kind":{"type":"string","const":"gateway"}},"required":["kind","label"]},{"type":"object","additionalProperties":false,"properties":{"label":{"type":"string"},"kind":{"type":"string","const":"external"}},"required":["kind","label"]}],"description":"Connection-scoped auth status shared by Sessions on that provider connection.\nIt contains no account, organization, plan, or vendor details."},
"SessionSettings":{"type":"object","additionalProperties":false,"properties":{"mode":{"type":["string","null"]},"model":{"type":["string","null"]},"effort":{"type":["string","null"]},"config":{"type":"array","items":{"$ref":"#/$defs/ConfigValue"}}},"required":["mode","model","effort","config"],"description":"Current settings reported for one provider Session."},
"ConfigValue":{"type":"object","additionalProperties":false,"properties":{"id":{"type":"string"},"value":{"$ref":"#/$defs/ConfigValueState"}},"required":["id","value"],"description":"One current config option value, identified by the provider's option ID."},
"ConfigValueState":{"anyOf":[{"type":"string"},{"type":"boolean"}],"description":"ACP v1 config options currently report either a selected ID or a boolean."},
"ObservationCursor":{"type":"object","additionalProperties":false,"properties":{"epoch":{"type":"integer","format":"uint64","minimum":0,"maximum":18446744073709551615},"afterSequence":{"type":"integer","format":"uint64","minimum":0,"maximum":18446744073709551615}},"required":["epoch","afterSequence"],"description":"A provider Session's hub position: pass both as `epoch` and `afterSequence`."},
"ProviderSnapshotMarker":{"oneOf":[{"type":"object","additionalProperties":false,"properties":{"cursor":{"$ref":"#/$defs/ObservationCursor"},"kind":{"type":"string","const":"snapshotEnd"}},"required":["kind","cursor"]}],"description":"The last position of the retained history sent by one provider observation."},
"ProviderObservationEventTooLarge":{"type":"object","additionalProperties":false,"properties":{"kind":{"$ref":"#/$defs/ProviderObservationEventTooLargeKind"},"sequence":{"type":"integer","format":"uint64","minimum":0,"maximum":18446744073709551615},"itemId":{"type":["string","null"]}},"required":["kind","sequence","itemId"],"description":"A retained event could not fit inside one message after JSON encoding."},
"ProviderObservationEventTooLargeKind":{"type":"string","enum":["eventTooLarge"]},
"ObservationSequence":{"type":"integer","format":"uint64","minimum":0,"maximum":18446744073709551615},
"ProviderObservationRecord":{"oneOf":[{"type":"object","properties":{"sequence":{"$ref":"#/$defs/ObservationSequence"},"event":{"$ref":"#/$defs/SessionEvent"}},"required":["sequence","event"],"additionalProperties":false},{"$ref":"#/$defs/ProviderSnapshotMarker"},{"type":"object","properties":{"kind":{"const":"resyncRequired"}},"required":["kind"],"additionalProperties":false},{"$ref":"#/$defs/ProviderObservationEventTooLarge"}]},
"ProviderObservationNotification":{"type":"object","properties":{"event":{"$ref":"#/$defs/ProviderObservationRecord"},"cursor":{}},"required":["event","cursor"],"additionalProperties":false,"if":{"properties":{"event":{"anyOf":[{"type":"object","properties":{"kind":{"const":"resyncRequired"}},"required":["kind"],"additionalProperties":false},{"required":["event"],"properties":{"event":{"required":["kind"],"properties":{"kind":{"const":"resyncRequired"}}}}}]}}},"then":{"properties":{"cursor":{"type":"null"}}},"else":{"properties":{"cursor":{"$ref":"#/$defs/ObservationCursor"}}}}}}
