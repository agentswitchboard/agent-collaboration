{
  "$defs": {
    "AssistantBody": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "message",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "thinking",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call": {
              "$ref": "#/$defs/ToolCall"
            },
            "kind": {
              "const": "toolCall",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "call"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entries": {
              "items": {
                "$ref": "#/$defs/PlanEntry"
              },
              "type": "array"
            },
            "kind": {
              "const": "plan",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "entries"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "other",
              "type": "string"
            },
            "sourceKind": {
              "type": "string"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "sourceKind"
          ],
          "type": "object"
        }
      ]
    },
    "BoundedText": {
      "additionalProperties": false,
      "description": "Text as reported, with a marker when the producer shortened it.",
      "properties": {
        "cut": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "cut"
      ],
      "type": "object"
    },
    "DecimalCount": {
      "description": "A nonnegative integer represented on the wire by its exact decimal digits.",
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$(?![\\s\\S])",
      "type": "string"
    },
    "FileChange": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "$ref": "#/$defs/FileChangeKind"
        },
        "diff": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileDiff"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "change"
      ],
      "type": "object"
    },
    "FileChangeKind": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "added",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "changed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "removed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "kind": {
              "const": "moved",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "from"
          ],
          "type": "object"
        }
      ]
    },
    "FileDiff": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "texts",
              "type": "string"
            },
            "new": {
              "type": "string"
            },
            "old": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "new"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unifiedPatch",
              "type": "string"
            },
            "patch": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "patch"
          ],
          "type": "object"
        }
      ]
    },
    "FileLocation": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FirstSeenAtMs": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "GroupId": {
      "description": "The name of an assistant group within a session.",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 256
    },
    "GroupPlace": {
      "additionalProperties": false,
      "description": "The assistant group and its fixed place in session history.",
      "properties": {
        "id": {
          "$ref": "#/$defs/GroupId"
        },
        "order": {
          "$ref": "#/$defs/ItemOrder"
        }
      },
      "required": [
        "id",
        "order"
      ],
      "type": "object"
    },
    "ItemBody": {
      "description": "The role an item is drawn under determines the bodies it can carry.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "body": {
              "$ref": "#/$defs/UserBody"
            },
            "kind": {
              "const": "user",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "body"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "body": {
              "$ref": "#/$defs/AssistantBody"
            },
            "group": {
              "$ref": "#/$defs/GroupPlace"
            },
            "kind": {
              "const": "assistant",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "group",
            "body"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "body": {
              "$ref": "#/$defs/SessionBody"
            },
            "kind": {
              "const": "session",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "body"
          ],
          "type": "object"
        }
      ]
    },
    "ItemId": {
      "description": "A stable name for an item within a session.",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 256
    },
    "ItemOrder": {
      "$ref": "#/$defs/DecimalCount",
      "description": "An item's or group's fixed place, written as exact decimal text."
    },
    "LineRange": {
      "additionalProperties": false,
      "description": "A nonempty range starting at a one-based line number.",
      "properties": {
        "firstLine": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "lineCount": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "firstLine",
        "lineCount"
      ],
      "type": "object"
    },
    "MachineId": {
      "description": "The Router install's durable identity, shared with central.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "MoneyAmount": {
      "description": "A reported nonnegative decimal amount with its original fractional precision.",
      "maxLength": 40,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])",
      "type": "string"
    },
    "MoneyCurrency": {
      "description": "The currency name supplied with a money amount.",
      "maxLength": 16,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 16
    },
    "PlanEntry": {
      "additionalProperties": false,
      "properties": {
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanEntryPriority"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/PlanEntryState"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "state"
      ],
      "type": "object"
    },
    "PlanEntryPriority": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "type": "string"
    },
    "PlanEntryState": {
      "enum": [
        "pending",
        "inProgress",
        "completed"
      ],
      "type": "string"
    },
    "RawInput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "notReported",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An opaque JSON value, including null. Equality follows serde_json;\nnumbers outside its exact representation are subject to its numeric limits.",
          "properties": {
            "kind": {
              "const": "value",
              "type": "string"
            },
            "value": {}
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "$ref": "#/$defs/DecimalCount"
            },
            "kind": {
              "const": "tooLarge",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bytes"
          ],
          "type": "object"
        }
      ]
    },
    "SearchOver": {
      "enum": [
        "fileNames",
        "fileContents",
        "web"
      ],
      "type": "string"
    },
    "SessionBody": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "notice",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "settingChange",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "usage",
              "type": "string"
            },
            "reading": {
              "$ref": "#/$defs/UsageReading"
            }
          },
          "required": [
            "kind",
            "reading"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "other",
              "type": "string"
            },
            "sourceKind": {
              "type": "string"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "sourceKind"
          ],
          "type": "object"
        }
      ]
    },
    "SessionId": {
      "description": "One agent conversation, as its provider (Claude Code, Codex) minted it:\nstored as given, 1 to 4096 UTF-8 bytes without NUL.",
      "type": "string"
    },
    "SessionRef": {
      "additionalProperties": false,
      "description": "The one session address (owner, 2026-11-18): the Router install that holds\nthe session, by its machine id, and the provider's session id. Used on the\nwire, at central and by agents. It has no endpoint: which harness holds a\nsession is the Router's own business.",
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "sessionId": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "machineId",
        "sessionId"
      ],
      "type": "object"
    },
    "ToolAction": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "notReported",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            },
            "folder": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "shell",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "command"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "changes": {
              "items": {
                "$ref": "#/$defs/FileChange"
              },
              "type": "array"
            },
            "kind": {
              "const": "fileChange",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "changes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fileRead",
              "type": "string"
            },
            "lines": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LineRange"
                },
                {
                  "type": "null"
                }
              ]
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "search",
              "type": "string"
            },
            "over": {
              "$ref": "#/$defs/SearchOver"
            },
            "query": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "query",
            "over"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fetch",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "child": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SessionRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "subAgent",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "input": {
              "$ref": "#/$defs/RawInput"
            },
            "kind": {
              "const": "other",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "input"
          ],
          "type": "object"
        }
      ]
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ToolAction"
        },
        "kind": {
          "$ref": "#/$defs/ToolKind"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/FileLocation"
          },
          "type": "array"
        },
        "sourceName": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ToolState"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "action",
        "state",
        "locations"
      ],
      "type": "object"
    },
    "ToolKind": {
      "enum": [
        "read",
        "edit",
        "delete",
        "move",
        "search",
        "execute",
        "think",
        "fetch",
        "other"
      ],
      "type": "string"
    },
    "ToolState": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pending",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "running",
              "type": "string"
            },
            "outputSoFar": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BoundedText"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "exitCode": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "completed",
              "type": "string"
            },
            "output": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BoundedText"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "exitCode": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "failed",
              "type": "string"
            },
            "message": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BoundedText"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BoundedText"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "declined",
              "type": "string"
            },
            "message": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BoundedText"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "TurnId": {
      "description": "The name of a turn to which an item belongs.",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 256
    },
    "UsageAmount": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "capacity": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DecimalCount"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "const": "count",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/DecimalCount"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "amount": {
              "$ref": "#/$defs/MoneyAmount"
            },
            "currency": {
              "$ref": "#/$defs/MoneyCurrency"
            },
            "kind": {
              "const": "money",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "amount",
            "currency"
          ],
          "type": "object"
        }
      ]
    },
    "UsageMetric": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "contextUsed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "inputTokens",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "outputTokens",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reasoningTokens",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "cacheReadTokens",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "cacheWriteTokens",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
